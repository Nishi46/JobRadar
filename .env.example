# Copy to .env (gitignored) for local development: cp .env.example .env
# These are local-only dummy credentials. Real secrets never go in this file.

# Used by infra/docker-compose.yml.
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar
# Host port. Not 5432, so it does not clash with a Postgres already on this machine.
POSTGRES_PORT=5440

# Used by Alembic and (later) the pipeline. Must agree with the values above.
DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5440/jobradar

# --- M2: LLM providers. Real keys go in .env only (gitignored), never here. ---
# Extraction and profile extraction (Claude). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Re-ranking (GPT). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- M2: tracing to Langfuse over OpenTelemetry (jobradar/tracing.py). ---
# Optional: leave the keys empty and tracing is off; the pipeline runs the same and
# llm_runs still records every call's tokens and cost.
# Keys: Langfuse project -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Your project's region: https://us.cloud.langfuse.com (US), https://cloud.langfuse.com (EU),
# or a self-hosted URL.
LANGFUSE_HOST=https://us.cloud.langfuse.com
